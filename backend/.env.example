DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_resume_analyzer
APP_NAME=CareerFit AI
DEBUG=false
LOG_LEVEL=INFO
# Resume-job semantic similarity (local). BAAI/bge-small-en-v1.5 recommended; fallback: all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.6
# AI-based skill extraction: BGE embedding similarity in addition to dictionary (detects variants e.g. ML → Machine Learning)
USE_EMBEDDING_SKILL_EXTRACTION=true
SKILL_EMBEDDING_THRESHOLD=0.72
# Semantic skill matching: treat job/market skill as matched if cosine_sim(embed(skill), embed(resume_skill)) >= threshold (e.g. REST API ≈ Backend API)
USE_SEMANTIC_SKILL_MATCHING=true
SEMANTIC_SKILL_MATCH_THRESHOLD=0.8
SCRAPER_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) CareerFit-AI/1.0
SCRAPER_DELAY_SECONDS=2
SCRAPER_CACHE_DAYS=7
# false = scraped job listings stay in memory only (live HTML); true = also write Job rows to PostgreSQL.
PERSIST_SCRAPED_JOBS=false
# false = uploaded resume PDF text + extracted skills stay in memory only; true = store resumes in PostgreSQL.
PERSIST_RESUMES=false
# true = gap analysis and job match use only in-memory scraped jobs for demand (no DB aggregates / corpus / synthetic fallbacks).
LIVE_MARKET_ONLY=true
# LinkedIn job search URL tuning (same idea as n8n: keywords/location + f_TPR + filters).
# SCRAPER_DEFAULT_TIME_WINDOW_HOURS=24   # → f_TPR=r86400 (omit or empty for no time filter)
# LINKEDIN_SCRAPER_EXPERIENCE_FILTER=Mid-Senior level
# LINKEDIN_SCRAPER_REMOTE_FILTER=Remote, Hybrid
# LINKEDIN_SCRAPER_JOB_TYPE_FILTER=Full-time, Contract
# LINKEDIN_SCRAPER_EASY_APPLY=true
# Use Scrapling (TLS impersonation) for linkedin.com fetches instead of plain httpx (better guest HTML).
# LINKEDIN_USE_SCRAPLING_FETCHER=true
MAX_UPLOAD_MB=10

# Redis — optional. Empty = no L2 embedding cache, no ARQ background queue (gap analysis still works synchronously).
# REDIS_URL=redis://localhost:6379/0

# Local LLM — enables verified resume skills (LLM filters KeyBERT phrases to real skills), AI summary, and gap/match advice.
# Ollama: install from https://ollama.com then run `ollama run llama3.2` (or another model). Leave empty to disable.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
# HTTP read timeout for POST /api/generate (seconds). CPU-only VMs often need 120–180; logs showing 500 at ~1m0s mean bump this.
LLM_TIMEOUT_SECONDS=120
# LLM_PROMPTS_PATH=  # optional: path to JSON file with prompt templates (see data/prompts.json)

# Panel / demo: browser-readable API log tail (requires file logging). Use a strong token; disable after the demo on public IPs.
# sudo mkdir -p /var/log/careerfit-ai && sudo chown $USER:$USER /var/log/careerfit-ai
# LOG_FILE_PATH=/var/log/careerfit-ai/app.log
# LOG_VIEWER_ENABLED=true
# LOG_VIEWER_TOKEN=
# LOG_VIEWER_MAX_LINES=400
# Browser: /api/logs/watch?token=... (auto-refresh) or /api/logs/recent?token=... (plain snapshot)

# Gap analysis — "Top skills to learn" uses this many role-filtered live jobs (unique skills, frequency in slice), then LLM verification.
# TOP_SKILLS_LIVE_JOB_SAMPLE_SIZE=5
